+namespace {
+constexpr const char *KEY_MEDIA_FOLDER = "selectionFx/mediaFolder";
+constexpr const char *KEY_IMAGE_ENABLED = "selectionFx/imageEnabled";
+constexpr const char *KEY_SIZE_PERCENT = "selectionFx/sizePercent";
+constexpr const char *KEY_POSITION = "selectionFx/position";
+constexpr const char *KEY_IMAGE_OPACITY = "selectionFx/imageOpacity";
+constexpr const char *KEY_BORDER_ENABLED = "selectionFx/borderEnabled";
+constexpr const char *KEY_BORDER_OPACITY = "selectionFx/borderOpacity";
+constexpr const char *KEY_POP_INTENSITY = "selectionFx/popIntensity";
+constexpr const char *KEY_AUDIO_ENABLED = "selectionFx/audioEnabled";
+constexpr const char *KEY_VOLUME = "selectionFx/volume";
+constexpr const char *KEY_ONLY_ON_CHANGE = "selectionFx/onlyOnChange";
+// Older builds stored the pop animation as an on/off checkbox.
+constexpr const char *KEY_LEGACY_ANIMATION = "selectionFx/animationEnabled";
+constexpr const char *GROUP_CHARACTERS = "characterMedia";
+
+constexpr int MIN_SIZE_PERCENT = 5;
+constexpr int MAX_SIZE_PERCENT = 500;
+
+QString characterKey(const QString &characterName) {
+  return QStringLiteral("characterMedia/") + characterName;
+}
+
+// Windows file names are case-insensitive.
+bool samePath(const QString &a, const QString &b) {
+  return QString::compare(QDir::cleanPath(a), QDir::cleanPath(b),
+                          Qt::CaseInsensitive) == 0;
+}
+
+QSizeF fitSize(const QSizeF &container, const QSizeF &imageSize,
+               int sizePercent) {
+  const qreal fraction =
+      qBound(MIN_SIZE_PERCENT, sizePercent, MAX_SIZE_PERCENT) / 100.0;
+  const QSizeF box(container.width() * fraction, container.height() * fraction);
+  return imageSize.scaled(box, Qt::KeepAspectRatio);
+}
+} // namespace
+
+QString defaultMediaFolder() {
+  return QCoreApplication::applicationDirPath() + QStringLiteral("/media");
+}
+
+Settings Settings::load() {
+  const Config &cfg = Config::instance();
+  Settings s;
+
+  s.mediaFolder =
+      cfg.customValue(KEY_MEDIA_FOLDER, defaultMediaFolder()).toString().trimmed();
+  if (s.mediaFolder.isEmpty()) {
+    s.mediaFolder = defaultMediaFolder();
+  }
+  s.imageEnabled = cfg.customValue(KEY_IMAGE_ENABLED, true).toBool();
+  s.sizePercent = qBound(MIN_SIZE_PERCENT,
+                         cfg.customValue(KEY_SIZE_PERCENT, 35).toInt(),
+                         MAX_SIZE_PERCENT);
+  s.position =
+      qBound(0, cfg.customValue(KEY_POSITION, s.position).toInt(), PositionCustom);
+  s.imageOpacity = qBound(0, cfg.customValue(KEY_IMAGE_OPACITY, 100).toInt(), 100);
+  s.borderEnabled = cfg.customValue(KEY_BORDER_ENABLED, false).toBool();
+  s.borderOpacity = qBound(0, cfg.customValue(KEY_BORDER_OPACITY, 100).toInt(), 100);
+
+  s.popIntensity = qBound(0, cfg.customValue(KEY_POP_INTENSITY, 45).toInt(), 100);
+  if (!cfg.customValue(KEY_POP_INTENSITY).isValid() &&
+      !cfg.customValue(KEY_LEGACY_ANIMATION, true).toBool()) {
+    s.popIntensity = 0; // the old checkbox was switched off
+  }
+
+  s.audioEnabled = cfg.customValue(KEY_AUDIO_ENABLED, true).toBool();
+  s.volume = qBound(0, cfg.customValue(KEY_VOLUME, 70).toInt(), 100);
+  s.onlyOnChange = cfg.customValue(KEY_ONLY_ON_CHANGE, true).toBool();
+  return s;
+}
+
+void Settings::save() const {
+  Config &cfg = Config::instance();
+  cfg.setCustomValue(KEY_MEDIA_FOLDER, mediaFolder);
+  cfg.setCustomValue(KEY_IMAGE_ENABLED, imageEnabled);
+  cfg.setCustomValue(KEY_SIZE_PERCENT, sizePercent);
+  cfg.setCustomValue(KEY_POSITION, position);
+  cfg.setCustomValue(KEY_IMAGE_OPACITY, imageOpacity);
+  cfg.setCustomValue(KEY_BORDER_ENABLED, borderEnabled);
+  cfg.setCustomValue(KEY_BORDER_OPACITY, borderOpacity);
+  cfg.setCustomValue(KEY_POP_INTENSITY, popIntensity);
+  cfg.setCustomValue(KEY_AUDIO_ENABLED, audioEnabled);
+  cfg.setCustomValue(KEY_VOLUME, volume);
+  cfg.setCustomValue(KEY_ONLY_ON_CHANGE, onlyOnChange);
+}
+
+MediaStyle Settings::styleFor(const CharacterMedia &media) const {
+  MediaStyle style;
+  style.sizePercent = media.sizePercent > 0 ? media.sizePercent : sizePercent;
+  style.imageOpacity = imageOpacity;
+  style.borderEnabled = borderEnabled;
+  style.borderOpacity = borderOpacity;
+  style.popIntensity = popIntensity;
+
+  if (position == PositionCustom) {
+    if (media.hasCustomPosition) {
+      style.custom = true;
+      style.customCenter = QPointF(media.customX, media.customY);
+    } else {
+      style.position = OverlayPosition::BottomLeft; // never positioned yet
+    }
+  } else {
+    style.position = static_cast<OverlayPosition>(position);
+  }
+  return style;
+}
+
+CharacterMedia characterMedia(const QString &characterName) {
+  CharacterMedia media;
+  if (characterName.isEmpty()) {
+    return media;
+  }
+  const Config &cfg = Config::instance();
+  const QString base = characterKey(characterName) + QLatin1Char('/');
+  media.image = cfg.customValue(base + QStringLiteral("image")).toString();
+  media.audio = cfg.customValue(base + QStringLiteral("audio")).toString();
+  media.sizePercent =
+      qBound(0, cfg.customValue(base + QStringLiteral("sizePercent"), 0).toInt(),
+             MAX_SIZE_PERCENT);
+
+  const QVariant x = cfg.customValue(base + QStringLiteral("customX"));
+  const QVariant y = cfg.customValue(base + QStringLiteral("customY"));
+  if (x.isValid() && y.isValid()) {
+    media.hasCustomPosition = true;
+    media.customX = qBound(0.0, x.toDouble(), 1.0);
+    media.customY = qBound(0.0, y.toDouble(), 1.0);
+  }
+  return media;
+}
+
+void setCharacterMedia(const QString &characterName,
+                       const CharacterMedia &media) {
+  if (characterName.isEmpty()) {
+    return;
+  }
+  Config &cfg = Config::instance();
+  const QString base = characterKey(characterName) + QLatin1Char('/');
+  cfg.setCustomValue(base + QStringLiteral("image"), media.image);
+  cfg.setCustomValue(base + QStringLiteral("audio"), media.audio);
+  cfg.setCustomValue(base + QStringLiteral("sizePercent"), media.sizePercent);
+  if (media.hasCustomPosition) {
+    cfg.setCustomValue(base + QStringLiteral("customX"), media.customX);
+    cfg.setCustomValue(base + QStringLiteral("customY"), media.customY);
+  }
+}
+
+void removeCharacterMedia(const QString &characterName) {
+  if (!characterName.isEmpty()) {
+    Config::instance().removeCustomKey(characterKey(characterName));
+  }
+}
+
+QStringList configuredCharacters() {
+  return Config::instance().customChildGroups(
+      QString::fromLatin1(GROUP_CHARACTERS));
+}
+
+QStringList imageNameFilters() {
+  return {QStringLiteral("*.png"), QStringLiteral("*.jpg"),
+          QStringLiteral("*.jpeg"), QStringLiteral("*.bmp"),
+          QStringLiteral("*.gif")};
+}
+
+QStringList audioNameFilters() {
+  return {QStringLiteral("*.wav"), QStringLiteral("*.mp3"),
+          QStringLiteral("*.ogg"), QStringLiteral("*.flac"),
+          QStringLiteral("*.m4a")};
+}
+
+static bool matchesFilters(const QString &fileName, const QStringList &filters) {
+  const QString suffix = QFileInfo(fileName).suffix().toLower();
+  for (const QString &filter : filters) {
+    if (filter.mid(2) == suffix) { // "*.png" -> "png"
+      return true;
+    }
+  }
+  return false;
+}
+
+bool isImageFile(const QString &fileName) {
+  return matchesFilters(fileName, imageNameFilters());
+}
+
+bool isAudioFile(const QString &fileName) {
+  return matchesFilters(fileName, audioNameFilters());
+}
+
+QStringList listMediaFiles(const QString &folder, const QStringList &filters) {
+  const QDir dir(folder);
+  if (folder.isEmpty() || !dir.exists()) {
+    return QStringList();
+  }
+  return dir.entryList(filters, QDir::Files, QDir::Name | QDir::IgnoreCase);
+}
+
+QString resolveMediaPath(const QString &folder, const QString &fileOrPath) {
+  if (fileOrPath.isEmpty()) {
+    return QString();
+  }
+  if (QFileInfo(fileOrPath).isAbsolute()) {
+    return fileOrPath;
+  }
+  return QDir(folder).filePath(fileOrPath);
+}
+
+QString importIntoFolder(const QString &folder, const QString &sourcePath) {
+  const QFileInfo source(sourcePath);
+  if (!source.exists() || !source.isFile() || folder.isEmpty()) {
+    return QString();
+  }
+
+  QDir dir(folder);
+  if (!dir.exists() && !QDir().mkpath(folder)) {
+    return QString();
+  }
+
+  // Already in the media folder: nothing to copy.
+  if (samePath(source.absolutePath(), dir.absolutePath())) {
+    return source.fileName();
+  }
+
+  QString name = source.fileName();
+  for (int attempt = 0; attempt < 1000; ++attempt) {
+    const QFileInfo target(dir.filePath(name));
+    if (!target.exists()) {
+      break;
+    }
+    if (target.size() == source.size()) {
+      return name; // same file was imported before
+    }
+    name = QStringLiteral("%1_%2.%3")
+               .arg(source.completeBaseName())
+               .arg(attempt + 1)
+               .arg(source.suffix());
+  }
+
+  if (!QFile::copy(sourcePath, dir.filePath(name))) {
+    return QString();
+  }
+  return name;
+}
+
+QRectF imageRect(const QSizeF &container, const QSizeF &imageSize,
+                 int sizePercent, OverlayPosition position, qreal margin) {
+  if (container.isEmpty() || imageSize.isEmpty()) {
+    return QRectF();
+  }
+
+  // No clamping to the container: an image bigger than the window is allowed
+  // and gets cropped by the window edge when drawn.
+  const QSizeF size = fitSize(container, imageSize, sizePercent);
+  if (size.width() < 1.0 || size.height() < 1.0) {
+    return QRectF();
+  }
+
+  const qreal left = margin;
+  const qreal centerX = (container.width() - size.width()) / 2.0;
+  const qreal right = container.width() - size.width() - margin;
+  const qreal top = margin;
+  const qreal centerY = (container.height() - size.height()) / 2.0;
+  const qreal bottom = container.height() - size.height() - margin;
+
+  qreal x = left;
+  qreal y = bottom;
+  switch (position) {
+  case OverlayPosition::TopLeft:      x = left;    y = top;     break;
+  case OverlayPosition::TopCenter:    x = centerX; y = top;     break;
+  case OverlayPosition::TopRight:     x = right;   y = top;     break;
+  case OverlayPosition::CenterLeft:   x = left;    y = centerY; break;
+  case OverlayPosition::Center:       x = centerX; y = centerY; break;
+  case OverlayPosition::CenterRight:  x = right;   y = centerY; break;
+  case OverlayPosition::BottomLeft:   x = left;    y = bottom;  break;
+  case OverlayPosition::BottomCenter: x = centerX; y = bottom;  break;
+  case OverlayPosition::BottomRight:  x = right;   y = bottom;  break;
+  }
+  return QRectF(QPointF(x, y), size);
+}
+
+QRectF mediaRect(const QSizeF &container, const QSizeF &imageSize,
+                 const MediaStyle &style) {
+  if (!style.custom) {
+    return imageRect(container, imageSize, style.sizePercent, style.position,
+                     PresetMargin);
+  }
+
+  if (container.isEmpty() || imageSize.isEmpty()) {
+    return QRectF();
+  }
+  const QSizeF size = fitSize(container, imageSize, style.sizePercent);
+  if (size.width() < 1.0 || size.height() < 1.0) {
+    return QRectF();
+  }
+  const QPointF center(qBound(0.0, style.customCenter.x(), 1.0) * container.width(),
+                       qBound(0.0, style.customCenter.y(), 1.0) * container.height());
+  return QRectF(QPointF(center.x() - size.width() / 2.0,
+                        center.y() - size.height() / 2.0),
+                size);
+}
+
+void paintMedia(QPainter &painter, const QRectF &box, const QPixmap &frame,
+                const MediaStyle &style, const QColor &borderColor,
+                qreal popProgress) {
+  if (frame.isNull() || box.isEmpty()) {
+    return;
+  }
+
+  // Pop animation: the image starts larger and more transparent, then settles.
+  const qreal intensity = qBound(0, style.popIntensity, 100) / 100.0;
+  const qreal settle = 1.0 - qBound(0.0, popProgress, 1.0);
+  const qreal scale = 1.0 + 0.5 * intensity * settle * settle;
+  const qreal fade = 1.0 - qMin(1.0, intensity * 1.5) * settle;
+
+  const qreal imageOpacity = qBound(0, style.imageOpacity, 100) / 100.0;
+  const qreal borderOpacity = qBound(0, style.borderOpacity, 100) / 100.0;
+
+  painter.save();
+  painter.setRenderHint(QPainter::SmoothPixmapTransform, true);
+  painter.translate(box.center());
+  painter.scale(scale, scale);
+  painter.translate(-box.center());
+
+  painter.setOpacity(imageOpacity * fade);
+  painter.drawPixmap(box, frame, QRectF(frame.rect()));
+
+  if (style.borderEnabled) {
+    QColor color = borderColor;
+    color.setAlpha(255); // opacity comes from the painter
+    painter.setOpacity(borderOpacity * fade);
+    painter.setBrush(Qt::NoBrush);
+    painter.setPen(QPen(color, 2.0));
+    painter.drawRect(box.adjusted(1.0, 1.0, -1.0, -1.0));
+  }
+
+  painter.restore();
+}
+
+} // namespace SelectionFx
