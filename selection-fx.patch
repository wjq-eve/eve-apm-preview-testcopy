diff -ruN a/include/selectionfx.h b2/include/selectionfx.h
--- a/include/selectionfx.h	1970-01-01 00:00:00.000000000 +0000
+++ b2/include/selectionfx.h	2026-10-15 17:30:27.754625894 +0000
@@ -0,0 +1,77 @@
+#ifndef SELECTIONFX_H
+#define SELECTIONFX_H
+
+#include "overlayinfo.h"
+#include <QRectF>
+#include <QSizeF>
+#include <QString>
+#include <QStringList>
+
+/// RTS-style "unit selected" feedback: an image or GIF shown on a client's
+/// thumbnail (animated when the client is selected) plus an audio clip.
+///
+/// Everything is configured in Settings -> Selection Feedback. Settings are
+/// stored in the active profile; media files live in one folder chosen by the
+/// user ("media folder").
+namespace SelectionFx {
+
+/// Global options (same for every character).
+struct Settings {
+  QString mediaFolder;
+  bool imageEnabled = true;
+  int sizePercent = 35; ///< image fits within this % of the preview window
+  int position = static_cast<int>(OverlayPosition::BottomLeft);
+  bool animationEnabled = true; ///< pop/fade-in animation on select
+  bool audioEnabled = true;
+  int volume = 70; ///< 0-100
+  bool onlyOnChange = true; ///< ignore re-selecting the active client
+
+  static Settings load();
+  void save() const;
+};
+
+/// Per-character media. File names are relative to the media folder (an
+/// absolute path is also accepted).
+struct CharacterMedia {
+  QString image;
+  QString audio;
+  int sizePercent = 0; ///< 0 = use Settings::sizePercent
+
+  bool isEmpty() const {
+    return image.isEmpty() && audio.isEmpty() && sizePercent <= 0;
+  }
+};
+
+QString defaultMediaFolder();
+
+CharacterMedia characterMedia(const QString &characterName);
+void setCharacterMedia(const QString &characterName,
+                       const CharacterMedia &media);
+void removeCharacterMedia(const QString &characterName);
+QStringList configuredCharacters();
+
+QStringList imageNameFilters(); ///< e.g. "*.png", "*.gif"
+QStringList audioNameFilters();
+bool isImageFile(const QString &fileName);
+bool isAudioFile(const QString &fileName);
+
+/// File names (not paths) in `folder` that match the filters, sorted.
+QStringList listMediaFiles(const QString &folder, const QStringList &filters);
+
+/// Turns a stored file name into a full path (absolute paths pass through).
+QString resolveMediaPath(const QString &folder, const QString &fileOrPath);
+
+/// Makes sure `sourcePath` is inside `folder`, copying it there if needed.
+/// Returns the file name to store, or an empty string on failure.
+QString importIntoFolder(const QString &folder, const QString &sourcePath);
+
+/// Where an image of `imageSize` is drawn inside a preview window of size
+/// `container`: scaled (aspect ratio kept) to fit within `sizePercent` of the
+/// container's width and height, anchored on the same 3x3 grid as the text
+/// overlays. Used by both the real thumbnails and the settings preview.
+QRectF imageRect(const QSizeF &container, const QSizeF &imageSize,
+                 int sizePercent, OverlayPosition position, qreal margin);
+
+} // namespace SelectionFx
+
+#endif // SELECTIONFX_H
