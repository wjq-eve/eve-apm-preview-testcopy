+
+/// One character's row in the list: name, image, audio and size override.
+/// Files dragged from Explorer onto the row are handed to `onFilesDropped`.
+class MediaRow : public QWidget {
+public:
+  MediaRow();
+
+  QLineEdit *nameEdit = nullptr;
+  QLabel *thumb = nullptr;
+  QComboBox *imageCombo = nullptr;
+  QPushButton *imageBrowse = nullptr;
+  QComboBox *audioCombo = nullptr;
+  QPushButton *audioBrowse = nullptr;
+  QPushButton *audioPlay = nullptr;
+  QSpinBox *sizeSpin = nullptr;
+  QPushButton *deleteButton = nullptr;
+
+  // Custom (dragged) position: image centre as a fraction of the window.
+  bool hasCustom = false;
+  double customX = 0.5;
+  double customY = 0.5;
+
+  std::function<void(const QStringList &)> onFilesDropped;
+  std::function<void()> onClicked;
+
+  void setSelectedLook(bool selected);
+
+protected:
+  void dragEnterEvent(QDragEnterEvent *event) override;
+  void dropEvent(QDropEvent *event) override;
+  void mousePressEvent(QMouseEvent *event) override;
+};
+
+/// The "Selection Feedback" page of the settings window.
+class SelectionFxPage : public QWidget {
