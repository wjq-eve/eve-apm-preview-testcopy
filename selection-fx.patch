diff -ruN a/include/voiceplayer.h b2/include/voiceplayer.h
--- a/include/voiceplayer.h	1970-01-01 00:00:00.000000000 +0000
+++ b2/include/voiceplayer.h	2026-10-15 17:30:27.756085931 +0000
@@ -0,0 +1,57 @@
+#ifndef VOICEPLAYER_H
+#define VOICEPLAYER_H
+
+#include <QHash>
+#include <QObject>
+#include <QString>
+
+class QAudioOutput;
+class QMediaPlayer;
+
+/// Plays the audio clip assigned to a character when its client is selected.
+///
+/// The clip comes from Settings -> Selection Feedback (a file in the user's
+/// media folder; WAV, MP3, OGG, FLAC or M4A). A new clip interrupts the
+/// previous one, like an RTS unit acknowledgement.
+class VoicePlayer : public QObject {
+  Q_OBJECT
+
+public:
+  explicit VoicePlayer(QObject *parent = nullptr);
+  ~VoicePlayer() override;
+
+  /// Starts the character's clip, cutting off whatever is playing. There is no
+  /// cooldown: the newest selection always wins. Returns false if nothing was
+  /// played (no clip assigned, file missing, ...).
+  bool play(const QString &characterName);
+  void stop();
+
+  /// Re-reads settings and preloads the configured clips. Call after the
+  /// settings change.
+  void reload();
+
+signals:
+  /// Emitted when a clip starts or stops, so the UI can animate the speaking
+  /// character's image.
+  void speakingChanged(const QString &characterName, bool speaking);
+
+private:
+  struct Voice {
+    QMediaPlayer *player = nullptr;
+    QAudioOutput *output = nullptr;
+    QString owner; // character the clip was last started for
+  };
+
+  static constexpr int MAX_VOICES = 48;
+
+  Voice *voiceFor(const QString &file);
+  void clearVoices();
+
+  QString m_mediaFolder;
+  int m_volume = 70;
+
+  QHash<QString, Voice *> m_voices; // file path -> voice
+  Voice *m_current = nullptr;
+};
+
+#endif // VOICEPLAYER_H
