diff -ruN a/include/selectionfx.h b2/include/selectionfx.h
--- a/include/selectionfx.h	1970-01-01 00:00:00.000000000 +0000
+++ b2/include/selectionfx.h	2026-10-16 00:17:41.828483319 +0000
@@ -0,0 +1,131 @@
+#ifndef SELECTIONFX_H
+#define SELECTIONFX_H
+
+#include "overlayinfo.h"
+#include <QPointF>
+#include <QRectF>
+#include <QSizeF>
+#include <QString>
+#include <QStringList>
+
+class QColor;
+class QPainter;
+class QPixmap;
+
+/// RTS-style "unit selected" feedback: an image or GIF shown on a client's
+/// thumbnail (animated when the client is selected) plus an audio clip.
+///
+/// Everything is configured in Settings -> Selection Feedback. Settings are
+/// stored in the active profile; media files live in one folder chosen by the
+/// user ("media folder").
+namespace SelectionFx {
+
+/// Index of the "Custom" entry in the position list (0-8 are the 3x3 presets,
+/// in OverlayPosition order).
+constexpr int PositionCustom = 9;
+
+/// Gap kept between the image and the window edge for the 3x3 presets.
+constexpr qreal PresetMargin = 8.0;
+
+/// Everything needed to lay out and draw one character's image.
+struct MediaStyle {
+  OverlayPosition position = OverlayPosition::BottomLeft; ///< used if !custom
+  bool custom = false;
+  QPointF customCenter = QPointF(0.5, 0.5); ///< image centre, 0-1 of the window
+  int sizePercent = 35;  ///< image fits within this % of the window (5-500)
+  int imageOpacity = 100; ///< 0-100
+  bool borderEnabled = false;
+  int borderOpacity = 100; ///< 0-100
+  int popIntensity = 45;   ///< 0 = no pop animation, 100 = strongest
+
+  bool operator==(const MediaStyle &o) const {
+    return position == o.position && custom == o.custom &&
+           customCenter == o.customCenter && sizePercent == o.sizePercent &&
+           imageOpacity == o.imageOpacity && borderEnabled == o.borderEnabled &&
+           borderOpacity == o.borderOpacity && popIntensity == o.popIntensity;
+  }
+  bool operator!=(const MediaStyle &o) const { return !(*this == o); }
+};
+
+/// Per-character media. File names are relative to the media folder (an
+/// absolute path is also accepted).
+struct CharacterMedia {
+  QString image;
+  QString audio;
+  int sizePercent = 0; ///< 0 = use Settings::sizePercent
+  bool hasCustomPosition = false;
+  double customX = 0.5; ///< image centre as a fraction of the window width
+  double customY = 0.5; ///< ... and of its height
+
+  bool isEmpty() const {
+    return image.isEmpty() && audio.isEmpty() && sizePercent <= 0;
+  }
+};
+
+/// Global options (same for every character).
+struct Settings {
+  QString mediaFolder;
+  bool imageEnabled = true;
+  int sizePercent = 35; ///< default image size, % of the preview window
+  int position = static_cast<int>(OverlayPosition::BottomLeft); ///< 0-9
+  int imageOpacity = 100;
+  bool borderEnabled = false;
+  int borderOpacity = 100;
+  int popIntensity = 45; ///< 0 = off
+  bool audioEnabled = true;
+  int volume = 70; ///< 0-100
+  bool onlyOnChange = true; ///< ignore re-selecting the active client
+
+  static Settings load();
+  void save() const;
+
+  /// Style for one character: the global options plus its own size and (when
+  /// the position is "Custom") its own dragged position.
+  MediaStyle styleFor(const CharacterMedia &media) const;
+};
+
+QString defaultMediaFolder();
+
+CharacterMedia characterMedia(const QString &characterName);
+void setCharacterMedia(const QString &characterName,
+                       const CharacterMedia &media);
+void removeCharacterMedia(const QString &characterName);
+QStringList configuredCharacters();
+
+QStringList imageNameFilters(); ///< e.g. "*.png", "*.gif"
+QStringList audioNameFilters();
+bool isImageFile(const QString &fileName);
+bool isAudioFile(const QString &fileName);
+
+/// File names (not paths) in `folder` that match the filters, sorted.
+QStringList listMediaFiles(const QString &folder, const QStringList &filters);
+
+/// Turns a stored file name into a full path (absolute paths pass through).
+QString resolveMediaPath(const QString &folder, const QString &fileOrPath);
+
+/// Makes sure `sourcePath` is inside `folder`, copying it there if needed.
+/// Returns the file name to store, or an empty string on failure.
+QString importIntoFolder(const QString &folder, const QString &sourcePath);
+
+/// Preset placement: the image scaled (aspect ratio kept) to fit within
+/// `sizePercent` of the container's width and height, anchored on the same 3x3
+/// grid as the text overlays. The result may be larger than the container; the
+/// part outside it is simply cropped when drawn.
+QRectF imageRect(const QSizeF &container, const QSizeF &imageSize,
+                 int sizePercent, OverlayPosition position, qreal margin);
+
+/// Where the image goes for `style` (preset or custom position). Used by both
+/// the real thumbnails and the settings preview, so they always agree.
+QRectF mediaRect(const QSizeF &container, const QSizeF &imageSize,
+                 const MediaStyle &style);
+
+/// Draws `frame` into `box` with the style's opacity, optional border and pop
+/// animation. `popProgress` runs 0 (just selected) to 1 (idle). The caller
+/// clips to the window, so anything outside it is cropped.
+void paintMedia(QPainter &painter, const QRectF &box, const QPixmap &frame,
+                const MediaStyle &style, const QColor &borderColor,
+                qreal popProgress);
+
+} // namespace SelectionFx
+
+#endif // SELECTIONFX_H
