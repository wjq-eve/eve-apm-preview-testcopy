+#include "voiceplayer.h"
+#include "selectionfx.h"
+#include <QAudioOutput>
+#include <QFileInfo>
+#include <QMediaPlayer>
+#include <QUrl>
+#include <utility>
+
+VoicePlayer::VoicePlayer(QObject *parent) : QObject(parent) { reload(); }
+
+VoicePlayer::~VoicePlayer() { clearVoices(); }
+
+void VoicePlayer::clearVoices() {
+  m_current = nullptr;
+  for (Voice *voice : std::as_const(m_voices)) {
+    voice->player->disconnect(this);
+    voice->player->stop();
+    voice->player->deleteLater();
+    voice->output->deleteLater();
+    delete voice;
+  }
+  m_voices.clear();
+}
+
+void VoicePlayer::reload() {
+  const SelectionFx::Settings fx = SelectionFx::Settings::load();
+  m_mediaFolder = fx.mediaFolder;
+  m_volume = fx.volume;
+
+  clearVoices();
+
+  // Preload every configured clip so the first selection plays without a
+  // loading delay.
+  if (!fx.audioEnabled) {
+    return;
+  }
+  const QStringList characters = SelectionFx::configuredCharacters();
+  for (const QString &name : characters) {
+    const SelectionFx::CharacterMedia media = SelectionFx::characterMedia(name);
+    if (media.audio.isEmpty()) {
+      continue;
+    }
+    const QString file = SelectionFx::resolveMediaPath(m_mediaFolder, media.audio);
+    if (QFileInfo::exists(file)) {
+      voiceFor(file);
+    }
+  }
+}
+
+VoicePlayer::Voice *VoicePlayer::voiceFor(const QString &file) {
+  auto it = m_voices.constFind(file);
+  if (it != m_voices.constEnd()) {
+    return it.value();
+  }
+  if (m_voices.size() >= MAX_VOICES) {
+    return nullptr;
+  }
+
+  auto *voice = new Voice;
+  voice->output = new QAudioOutput(this);
+  voice->player = new QMediaPlayer(this);
+  voice->player->setAudioOutput(voice->output);
+  voice->player->setSource(QUrl::fromLocalFile(file));
+
+  connect(voice->player, &QMediaPlayer::playbackStateChanged, this,
+          [this, voice](QMediaPlayer::PlaybackState state) {
+            if (!voice->owner.isEmpty()) {
+              emit speakingChanged(voice->owner,
+                                   state == QMediaPlayer::PlayingState);
+            }
+          });
+
+  m_voices.insert(file, voice);
+  return voice;
+}
+
+bool VoicePlayer::play(const QString &characterName) {
+  if (characterName.isEmpty()) {
+    return false;
+  }
+  const SelectionFx::CharacterMedia media =
+      SelectionFx::characterMedia(characterName);
+  if (media.audio.isEmpty()) {
+    return false;
+  }
+
+  const QString file = SelectionFx::resolveMediaPath(m_mediaFolder, media.audio);
+  if (!QFileInfo::exists(file)) {
+    return false;
+  }
+
+  Voice *voice = voiceFor(file);
+  if (!voice) {
+    return false;
+  }
+
+  if (m_current && m_current != voice) {
+    m_current->player->stop(); // a new clip cuts off the previous one
+  }
+
+  voice->owner = characterName;
+  voice->output->setVolume(m_volume / 100.0f);
+  voice->player->setPosition(0);
+  voice->player->play();
+
+  m_current = voice;
+  return true;
+}
+
+void VoicePlayer::stop() {
+  if (m_current) {
+    m_current->player->stop();
+  }
+}
