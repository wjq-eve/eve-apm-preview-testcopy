+MediaRow *SelectionFxPage::addRow(const QString &name,
+                                  const SelectionFx::CharacterMedia &media) {
+  auto *row = new MediaRow();
+  row->hasCustom = media.hasCustomPosition;
+  row->customX = media.customX;
+  row->customY = media.customY;
+
+  auto *outer = new QHBoxLayout(row);
+  outer->setContentsMargins(8, 6, 8, 6);
+  outer->setSpacing(8);
