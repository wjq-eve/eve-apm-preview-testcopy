+
+QStringList audioNameFilters() {
+  return {QStringLiteral("*.wav"), QStringLiteral("*.mp3"),
+          QStringLiteral("*.ogg"), QStringLiteral("*.flac"),
+          QStringLiteral("*.m4a")};
+}
+
+static bool matchesFilters(const QString &fileName, const QStringList &filters) {
+  const QString suffix = QFileInfo(fileName).suffix().toLower();
+  for (const QString &filter : filters) {
+    if (filter.mid(2) == suffix) { // "*.png" -> "png"
+      return true;
+    }
+  }
+  return false;
+}
+
+bool isImageFile(const QString &fileName) {
+  return matchesFilters(fileName, imageNameFilters());
+}
+
+bool isAudioFile(const QString &fileName) {
+  return matchesFilters(fileName, audioNameFilters());
+}
+
+QStringList listMediaFiles(const QString &folder, const QStringList &filters) {
+  const QDir dir(folder);
+  if (folder.isEmpty() || !dir.exists()) {
+    return QStringList();
+  }
+  return dir.entryList(filters, QDir::Files, QDir::Name | QDir::IgnoreCase);
+}
+
+QString resolveMediaPath(const QString &folder, const QString &fileOrPath) {
+  if (fileOrPath.isEmpty()) {
+    return QString();
+  }
+  if (QFileInfo(fileOrPath).isAbsolute()) {
+    return fileOrPath;
+  }
+  return QDir(folder).filePath(fileOrPath);
+}
+
+QString importIntoFolder(const QString &folder, const QString &sourcePath) {
+  const QFileInfo source(sourcePath);
+  if (!source.exists() || !source.isFile() || folder.isEmpty()) {
+    return QString();
+  }
+
+  QDir dir(folder);
+  if (!dir.exists() && !QDir().mkpath(folder)) {
+    return QString();
+  }
+
+  // Already in the media folder: nothing to copy.
+  if (samePath(source.absolutePath(), dir.absolutePath())) {
+    return source.fileName();
+  }
+
+  QString name = source.fileName();
+  for (int attempt = 0; attempt < 1000; ++attempt) {
+    const QFileInfo target(dir.filePath(name));
+    if (!target.exists()) {
+      break;
+    }
+    if (target.size() == source.size()) {
+      return name; // same file was imported before
+    }
+    name = QStringLiteral("%1_%2.%3")
+               .arg(source.completeBaseName())
+               .arg(attempt + 1)
+               .arg(source.suffix());
+  }
+
+  if (!QFile::copy(sourcePath, dir.filePath(name))) {
+    return QString();
+  }
+  return name;
+}
+
+QRectF imageRect(const QSizeF &container, const QSizeF &imageSize,
+                 int sizePercent, OverlayPosition position, qreal margin) {
+  if (container.isEmpty() || imageSize.isEmpty()) {
+    return QRectF();
+  }
+
+  const qreal fraction = qBound(5, sizePercent, 100) / 100.0;
+  QSizeF box(container.width() * fraction, container.height() * fraction);
+  box.setWidth(qMin(box.width(), container.width() - 2 * margin));
+  box.setHeight(qMin(box.height(), container.height() - 2 * margin));
+  if (box.width() < 1.0 || box.height() < 1.0) {
+    return QRectF();
+  }
+
+  const QSizeF size = imageSize.scaled(box, Qt::KeepAspectRatio);
+
+  const qreal left = margin;
+  const qreal centerX = (container.width() - size.width()) / 2.0;
+  const qreal right = container.width() - size.width() - margin;
+  const qreal top = margin;
+  const qreal centerY = (container.height() - size.height()) / 2.0;
+  const qreal bottom = container.height() - size.height() - margin;
+
+  qreal x = left;
+  qreal y = bottom;
+  switch (position) {
+  case OverlayPosition::TopLeft:      x = left;    y = top;     break;
+  case OverlayPosition::TopCenter:    x = centerX; y = top;     break;
+  case OverlayPosition::TopRight:     x = right;   y = top;     break;
+  case OverlayPosition::CenterLeft:   x = left;    y = centerY; break;
+  case OverlayPosition::Center:       x = centerX; y = centerY; break;
+  case OverlayPosition::CenterRight:  x = right;   y = centerY; break;
+  case OverlayPosition::BottomLeft:   x = left;    y = bottom;  break;
+  case OverlayPosition::BottomCenter: x = centerX; y = bottom;  break;
+  case OverlayPosition::BottomRight:  x = right;   y = bottom;  break;
+  }
+  return QRectF(QPointF(x, y), size);
+}
+
+} // namespace SelectionFx
