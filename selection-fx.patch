+VoicePlayer *MainWindow::ensureVoicePlayer() {
+  if (!m_voicePlayer) {
+    m_voicePlayer = std::make_unique<VoicePlayer>();
+    connect(m_voicePlayer.get(), &VoicePlayer::speakingChanged, this,
+            [this](const QString &name, bool speaking) {
+              for (ThumbnailWidget *t : std::as_const(thumbnails)) {
+                if (t && t->getCharacterName() == name) {
+                  t->setSpeaking(speaking);
+                  break;
+                }
+              }
+            });
+  }
+  return m_voicePlayer.get();
+}
+
+void MainWindow::playSelectionFeedback(HWND hwnd, bool wasAlreadyForeground) {
+  auto it = thumbnails.constFind(hwnd);
+  if (it == thumbnails.constEnd() || !it.value()) {
+    return;
+  }
+
+  ThumbnailWidget *thumb = it.value();
+  const QString characterName = thumb->getCharacterName();
+  if (characterName.isEmpty()) {
+    return; // not-logged-in clients and non-EVE windows have no character
+  }
+
+  const SelectionFx::Settings fx = SelectionFx::Settings::load();
+  if (fx.onlyOnChange && wasAlreadyForeground) {
+    return;
+  }
+
+  // The active client's thumbnail is hidden when "Hide Active Thumbnail" is
+  // on, so there is nothing to animate then (audio still plays).
+  if (!Config::instance().hideActiveClientThumbnail()) {
+    thumb->playSelectEffect();
+  }
+
+  if (fx.audioEnabled) {
+    ensureVoicePlayer()->play(characterName);
+  }
+}
