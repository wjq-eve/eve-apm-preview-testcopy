+// ---------------------------------------------------------------------------
+// Selection feedback: image / GIF on the preview, animated on select
+// ---------------------------------------------------------------------------
+
+namespace {
+constexpr int MEDIA_MAX_DIM = 512;
+constexpr int SELECT_ANIM_MS = 450;
+constexpr int SPEAK_GUARD_MS = 15000; // safety net if "stopped" never arrives
+constexpr int GIF_MIN_PLAY_MS = 2500; // how long a GIF plays with no audio
+} // namespace
+
+void OverlayWidget::setMedia(const QString &path) {
+  const QDateTime stamp =
+      path.isEmpty() ? QDateTime() : QFileInfo(path).lastModified();
+  if (path == m_mediaPath && stamp == m_mediaStamp) {
+    return; // nothing changed
+  }
+
+  if (m_movie) {
+    m_movie->stop();
+    m_movie->deleteLater();
+    m_movie = nullptr;
+  }
+  if (m_mediaHoldTimer) {
+    m_mediaHoldTimer->stop();
+  }
+  m_mediaPath = path;
+  m_mediaStamp = stamp;
+  m_mediaIdle = QPixmap();
+  m_mediaIdleScaled = QPixmap();
+  m_mediaIdleScaledPx = QSize();
+
+  if (!path.isEmpty()) {
+    QImageReader reader(path);
+    reader.setAutoTransform(true);
+    const bool animated = reader.supportsAnimation();
+    QImage image = reader.read(); // first frame for a GIF
+    if (image.isNull()) {
+      qWarning() << "OverlayWidget: could not load image" << path
+                 << reader.errorString();
+    } else {
+      if (image.width() > MEDIA_MAX_DIM || image.height() > MEDIA_MAX_DIM) {
+        image = image.scaled(MEDIA_MAX_DIM, MEDIA_MAX_DIM, Qt::KeepAspectRatio,
+                             Qt::SmoothTransformation);
+      }
+      m_mediaIdle = QPixmap::fromImage(image);
+
+      if (animated) {
+        auto *movie = new QMovie(path, QByteArray(), this);
+        if (movie->isValid()) {
+          m_movie = movie;
+          connect(m_movie, &QMovie::frameChanged, this, [this]() {
+            if (m_movie && m_movie->state() == QMovie::Running) {
+              update();
+            }
+          });
+        } else {
+          delete movie;
+        }
+      }
+    }
+  }
+  update();
+}
+
+void OverlayWidget::setMediaStyle(const SelectionFx::MediaStyle &style) {
+  if (m_style == style) {
+    return;
+  }
+  m_style = style;
+  m_mediaIdleScaledPx = QSize();
+  update();
+}
+
+void OverlayWidget::beginMediaPlayback(int holdMs) {
+  if (!m_movie) {
+    return;
+  }
+  if (!m_mediaHoldTimer) {
+    m_mediaHoldTimer = new QTimer(this);
+    m_mediaHoldTimer->setSingleShot(true);
+    connect(m_mediaHoldTimer, &QTimer::timeout, this,
+            [this]() { maybeStopMovie(); });
+  }
+  if (holdMs > 0) {
+    m_mediaHoldTimer->start(holdMs);
+  }
+  if (m_movie->state() != QMovie::Running) {
+    m_movie->start();
+  }
+}
+
+// A GIF keeps playing while the character is speaking or the minimum play time
+// hasn't run out; afterwards it returns to its first frame.
+void OverlayWidget::maybeStopMovie() {
+  if (!m_movie || m_speaking) {
+    return;
+  }
+  if (m_mediaHoldTimer && m_mediaHoldTimer->isActive()) {
+    return;
+  }
+  m_movie->stop();
+  update();
+}
+
+void OverlayWidget::playSelectAnimation() {
+  if (m_mediaIdle.isNull() || !isVisible()) {
+    return;
+  }
+
+  if (m_style.popIntensity > 0) {
+    if (!m_selectAnimation) {
+      m_selectAnimation = new QVariantAnimation(this);
+      m_selectAnimation->setStartValue(0.0);
+      m_selectAnimation->setEndValue(1.0);
+      m_selectAnimation->setDuration(SELECT_ANIM_MS);
+      m_selectAnimation->setEasingCurve(QEasingCurve::Linear);
+      connect(m_selectAnimation, &QVariantAnimation::valueChanged, this,
+              [this](const QVariant &value) {
+                m_selectProgress = value.toReal();
+                update();
+              });
+      connect(m_selectAnimation, &QVariantAnimation::finished, this, [this]() {
+        m_selectProgress = 1.0;
+        update();
+      });
+    }
+    m_selectAnimation->stop();
+    m_selectProgress = 0.0;
+    m_selectAnimation->start();
+  }
+
+  beginMediaPlayback(GIF_MIN_PLAY_MS);
+}
+
+void OverlayWidget::setSpeaking(bool speaking) {
+  if (speaking) {
+    if (m_mediaIdle.isNull() || !isVisible()) {
+      return;
+    }
+    if (!m_speakGuardTimer) {
+      m_speakGuardTimer = new QTimer(this);
+      m_speakGuardTimer->setSingleShot(true);
+      connect(m_speakGuardTimer, &QTimer::timeout, this,
+              [this]() { setSpeaking(false); });
+    }
+    m_speaking = true;
+    m_speakGuardTimer->start(SPEAK_GUARD_MS);
+    beginMediaPlayback(0);
+  } else {
+    if (!m_speaking) {
+      return;
+    }
+    m_speaking = false;
+    if (m_speakGuardTimer) {
+      m_speakGuardTimer->stop();
+    }
+    maybeStopMovie();
+  }
+}
+
+void OverlayWidget::hideEvent(QHideEvent *event) {
+  QWidget::hideEvent(event);
+  // Don't animate (or decode GIF frames) for a hidden preview.
+  if (m_movie) {
+    m_movie->stop();
+  }
+  if (m_mediaHoldTimer) {
+    m_mediaHoldTimer->stop();
+  }
+  if (m_selectAnimation) {
+    m_selectAnimation->stop();
+  }
+  m_selectProgress = 1.0;
+  if (m_speakGuardTimer) {
+    m_speakGuardTimer->stop();
+  }
+  m_speaking = false;
+}
+
+void OverlayWidget::drawMedia(QPainter &painter) {
+  if (m_mediaIdle.isNull()) {
+    return;
+  }
+
+  // Same layout function the settings preview uses, so what you see there is
+  // what you get here. The box may be larger than the window; the window edge
+  // crops whatever sticks out.
+  const QRectF box = SelectionFx::mediaRect(
+      QSizeF(size()), QSizeF(m_mediaIdle.size()), m_style);
+  if (box.width() < 2.0 || box.height() < 2.0) {
+    return;
+  }
+
+  const qreal dpr = devicePixelRatioF();
+  QPixmap frame;
+  if (m_movie && m_movie->state() == QMovie::Running) {
+    frame = m_movie->currentPixmap();
+  }
+  if (frame.isNull()) {
+    // Scale the still image once per size (not on every repaint), unless it is
+    // so large (image bigger than the window) that caching would waste memory.
+    const QSize px(qMax(1, qRound(box.width() * dpr)),
+                   qMax(1, qRound(box.height() * dpr)));
+    const bool cacheable = px.width() <= qRound(2.0 * width() * dpr) &&
+                           px.height() <= qRound(2.0 * height() * dpr);
+    if (cacheable) {
+      if (m_mediaIdleScaledPx != px || m_mediaIdleScaled.isNull()) {
+        m_mediaIdleScaled = m_mediaIdle.scaled(px, Qt::IgnoreAspectRatio,
+                                               Qt::SmoothTransformation);
+        m_mediaIdleScaled.setDevicePixelRatio(dpr);
+        m_mediaIdleScaledPx = px;
+      }
+      frame = m_mediaIdleScaled;
+    } else {
+      frame = m_mediaIdle;
+    }
+  }
+
+  const qreal progress = m_style.popIntensity > 0 ? m_selectProgress : 1.0;
+  painter.save();
+  painter.setClipRect(rect()); // crop anything beyond the window edges
+  SelectionFx::paintMedia(painter, box, frame, m_style,
+                          Config::instance().highlightColor(), progress);
+  painter.restore();
+}
+
 void OverlayWidget::paintEvent(QPaintEvent *) {
 
   QPainter painter(this);
   painter.setRenderHint(QPainter::Antialiasing);
 
+  drawMedia(painter);
   drawOverlays(painter);
 
   const Config &cfg = Config::instance();
