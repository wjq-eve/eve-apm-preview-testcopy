+}
+
+void MediaPreviewBox::setStyleOptions(const SelectionFx::MediaStyle &style) {
+  if (m_style == style) {
+    return;
+  }
+  m_style = style;
+  update();
+}
+
+void MediaPreviewBox::playPop() {
+  if (m_idle.isNull() || m_style.popIntensity <= 0) {
+    return;
+  }
+  if (!m_pop) {
+    m_pop = new QVariantAnimation(this);
+    m_pop->setStartValue(0.0);
+    m_pop->setEndValue(1.0);
+    m_pop->setDuration(POP_DURATION_MS);
+    m_pop->setEasingCurve(QEasingCurve::Linear);
+    connect(m_pop, &QVariantAnimation::valueChanged, this,
+            [this](const QVariant &value) {
+              m_popProgress = value.toReal();
+              update();
+            });
+    connect(m_pop, &QVariantAnimation::finished, this, [this]() {
+      m_popProgress = 1.0;
+      update();
+    });
+  }
+  m_pop->stop();
+  m_popProgress = 0.0;
+  m_pop->start();
+}
+
+QRectF MediaPreviewBox::currentBox() const {
+  if (m_idle.isNull()) {
+    return QRectF();
+  }
+  return SelectionFx::mediaRect(QSizeF(size()), QSizeF(m_idle.size()), m_style);
+}
+
+void MediaPreviewBox::setMedia(const QString &path) {
+  const QDateTime stamp =
+      path.isEmpty() ? QDateTime() : QFileInfo(path).lastModified();
+  if (path == m_path && stamp == m_stamp) {
+    return;
+  }
+  m_path = path;
+  m_stamp = stamp;
+
+  if (m_movie) {
+    m_movie->stop();
+    m_movie->deleteLater();
+    m_movie = nullptr;
+  }
+  m_idle = QPixmap();
+
+  if (!path.isEmpty() && QFileInfo::exists(path)) {
+    QImageReader reader(path);
+    reader.setAutoTransform(true);
+    const bool animated = reader.supportsAnimation();
+    QImage image = reader.read();
+    if (!image.isNull()) {
+      if (image.width() > MAX_IMAGE_DIM || image.height() > MAX_IMAGE_DIM) {
+        image = image.scaled(MAX_IMAGE_DIM, MAX_IMAGE_DIM, Qt::KeepAspectRatio,
+                             Qt::SmoothTransformation);
+      }
+      m_idle = QPixmap::fromImage(image);
+
+      if (animated) {
+        auto *movie = new QMovie(path, QByteArray(), this);
+        if (movie->isValid()) {
+          m_movie = movie;
+          connect(m_movie, &QMovie::frameChanged, this, [this]() { update(); });
+          if (isVisible()) {
+            m_movie->start();
+          }
+        } else {
+          delete movie;
+        }
+      }
+    }
+  }
+  update();
+}
+
+void MediaPreviewBox::showEvent(QShowEvent *event) {
+  QWidget::showEvent(event);
+  if (m_movie) {
+    m_movie->start();
+  }
+}
+
+void MediaPreviewBox::hideEvent(QHideEvent *event) {
+  QWidget::hideEvent(event);
+  if (m_movie) {
+    m_movie->stop();
+  }
+}
+
+void MediaPreviewBox::mousePressEvent(QMouseEvent *event) {
+  if (event->button() == Qt::LeftButton) {
+    const QRectF box = currentBox();
+    if (!box.isEmpty() && box.contains(event->position())) {
+      m_dragging = true;
+      m_grabOffset = event->position() - box.center();
+      setCursor(Qt::ClosedHandCursor);
+      if (onDragStarted) {
+        onDragStarted();
+      }
+      return;
+    }
+  }
+  QWidget::mousePressEvent(event);
+}
+
+void MediaPreviewBox::mouseMoveEvent(QMouseEvent *event) {
+  if (m_dragging) {
+    const QPointF center = event->position() - m_grabOffset;
+    const double fx = qBound(0.0, center.x() / width(), 1.0);
+    const double fy = qBound(0.0, center.y() / height(), 1.0);
+    if (onDragged) {
+      onDragged(fx, fy);
+    }
+    return;
+  }
+
+  const QRectF box = currentBox();
+  const bool overImage = !box.isEmpty() && box.contains(event->position());
+  setCursor(overImage ? Qt::OpenHandCursor : Qt::ArrowCursor);
+  QWidget::mouseMoveEvent(event);
+}
+
+void MediaPreviewBox::mouseReleaseEvent(QMouseEvent *event) {
+  if (m_dragging) {
+    m_dragging = false;
+    setCursor(Qt::OpenHandCursor);
+    return;
+  }
+  QWidget::mouseReleaseEvent(event);
+}
+
+void MediaPreviewBox::paintEvent(QPaintEvent *) {
+  QPainter painter(this);
+  painter.setRenderHint(QPainter::Antialiasing);
+  painter.setRenderHint(QPainter::SmoothPixmapTransform);
+
+  const QRectF bounds = QRectF(rect()).adjusted(0.5, 0.5, -0.5, -0.5);
+  QPainterPath windowShape;
+  windowShape.addRoundedRect(bounds, 4, 4);
+  painter.fillPath(windowShape, QColor(20, 24, 30));
+
+  painter.setPen(QColor(255, 255, 255, 45));
+  painter.drawText(bounds.adjusted(0, 6, 0, 0), Qt::AlignHCenter | Qt::AlignTop,
+                   QStringLiteral("Preview window"));
+
+  if (m_idle.isNull()) {
+    painter.setPen(QColor(150, 150, 150));
+    painter.drawText(bounds, Qt::AlignCenter,
+                     QStringLiteral("No image selected"));
+  } else {
+    const QRectF box = currentBox();
+    if (!box.isEmpty()) {
+      QPixmap frame;
+      if (m_movie && m_movie->state() == QMovie::Running) {
+        frame = m_movie->currentPixmap();
+      }
+      if (frame.isNull()) {
+        frame = m_idle;
+      }
+
+      painter.save();
+      painter.setClipPath(windowShape); // the window edge crops the image
+      SelectionFx::paintMedia(painter, box, frame, m_style,
+                              Config::instance().highlightColor(),
+                              m_popProgress);
+      painter.restore();
+    }
+  }
+
+  // Window outline, drawn last so it stays crisp over a cropped image.
+  painter.setBrush(Qt::NoBrush);
+  painter.setPen(QPen(QColor(0x3a, 0x3a, 0x3a), 1));
+  painter.drawRoundedRect(bounds, 4, 4);
+}
