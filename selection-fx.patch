+MediaRow::MediaRow() {
+  setObjectName(QStringLiteral("mediaRow"));
+  setAttribute(Qt::WA_StyledBackground, true);
+  setAcceptDrops(true);
+  setStyleSheet(rowStyle(false));
+}
+
+void MediaRow::setSelectedLook(bool selected) {
+  setStyleSheet(rowStyle(selected));
+}
+
+void MediaRow::dragEnterEvent(QDragEnterEvent *event) {
+  if (event->mimeData()->hasUrls()) {
+    event->acceptProposedAction();
+  }
+}
+
+void MediaRow::dropEvent(QDropEvent *event) {
+  QStringList files;
+  const QList<QUrl> urls = event->mimeData()->urls();
+  for (const QUrl &url : urls) {
+    if (url.isLocalFile()) {
+      files.append(url.toLocalFile());
+    }
+  }
+  if (!files.isEmpty()) {
+    event->acceptProposedAction();
+    if (onFilesDropped) {
+      onFilesDropped(files);
+    }
+  }
+}
+
+void MediaRow::mousePressEvent(QMouseEvent *event) {
+  if (onClicked) {
+    onClicked();
+  }
+  QWidget::mousePressEvent(event);
+}
