+  QSlider *m_borderOpacitySlider = nullptr;
+  QLabel *m_borderOpacityValue = nullptr;
+  QSlider *m_popSlider = nullptr;
+  QLabel *m_popValue = nullptr;
+  QPushButton *m_popButton = nullptr;
+  QCheckBox *m_audioCheck = nullptr;
+  QSlider *m_volumeSlider = nullptr;
+  QLabel *m_volumeValue = nullptr;
+  MediaPreviewBox *m_preview = nullptr;
+  QLabel *m_previewCaption = nullptr;
+
+  QWidget *m_rowsContainer = nullptr;
