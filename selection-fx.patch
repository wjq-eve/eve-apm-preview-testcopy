diff -ruN a/src/selectionfx.cpp b2/src/selectionfx.cpp
--- a/src/selectionfx.cpp	1970-01-01 00:00:00.000000000 +0000
+++ b2/src/selectionfx.cpp	2026-10-15 17:30:27.755352169 +0000
@@ -0,0 +1,231 @@
+#include "selectionfx.h"
+#include "config.h"
+#include <QCoreApplication>
+#include <QDir>
+#include <QFile>
+#include <QFileInfo>
+#include <QSet>
+#include <QtGlobal>
+
+namespace SelectionFx {
+
+namespace {
+constexpr const char *KEY_MEDIA_FOLDER = "selectionFx/mediaFolder";
+constexpr const char *KEY_IMAGE_ENABLED = "selectionFx/imageEnabled";
+constexpr const char *KEY_SIZE_PERCENT = "selectionFx/sizePercent";
+constexpr const char *KEY_POSITION = "selectionFx/position";
+constexpr const char *KEY_ANIMATION = "selectionFx/animationEnabled";
+constexpr const char *KEY_AUDIO_ENABLED = "selectionFx/audioEnabled";
+constexpr const char *KEY_VOLUME = "selectionFx/volume";
+constexpr const char *KEY_ONLY_ON_CHANGE = "selectionFx/onlyOnChange";
+constexpr const char *GROUP_CHARACTERS = "characterMedia";
+
+QString characterKey(const QString &characterName) {
+  return QStringLiteral("characterMedia/") + characterName;
+}
+
+// Windows file names are case-insensitive.
+bool samePath(const QString &a, const QString &b) {
+  return QString::compare(QDir::cleanPath(a), QDir::cleanPath(b),
+                          Qt::CaseInsensitive) == 0;
+}
+} // namespace
+
+QString defaultMediaFolder() {
+  return QCoreApplication::applicationDirPath() + QStringLiteral("/media");
+}
+
+Settings Settings::load() {
+  const Config &cfg = Config::instance();
+  Settings s;
+
+  s.mediaFolder =
+      cfg.customValue(KEY_MEDIA_FOLDER, defaultMediaFolder()).toString().trimmed();
+  if (s.mediaFolder.isEmpty()) {
+    s.mediaFolder = defaultMediaFolder();
+  }
+  s.imageEnabled = cfg.customValue(KEY_IMAGE_ENABLED, true).toBool();
+  s.sizePercent = qBound(5, cfg.customValue(KEY_SIZE_PERCENT, 35).toInt(), 100);
+  s.position = qBound(0, cfg.customValue(KEY_POSITION, s.position).toInt(), 8);
+  s.animationEnabled = cfg.customValue(KEY_ANIMATION, true).toBool();
+  s.audioEnabled = cfg.customValue(KEY_AUDIO_ENABLED, true).toBool();
