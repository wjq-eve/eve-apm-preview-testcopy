+QString SelectionFxPage::mediaFolder() const {
+  const QString text = m_folderEdit ? m_folderEdit->text().trimmed() : QString();
+  return text.isEmpty() ? SelectionFx::defaultMediaFolder() : text;
+}
+
+bool SelectionFxPage::isCustomPosition() const {
+  return m_positionCombo->currentData().toInt() == SelectionFx::PositionCustom;
+}
+
+SelectionFx::MediaStyle SelectionFxPage::styleForRow(const MediaRow *row) const {
+  SelectionFx::MediaStyle style;
+  style.sizePercent = (row && row->sizeSpin->value() > 0)
+                          ? row->sizeSpin->value()
+                          : m_sizeSlider->value();
+  style.imageOpacity = m_opacitySlider->value();
+  style.borderEnabled = m_borderCheck->isChecked();
+  style.borderOpacity = m_borderOpacitySlider->value();
+  style.popIntensity = m_popSlider->value();
+
+  if (isCustomPosition()) {
+    if (row && row->hasCustom) {
+      style.custom = true;
+      style.customCenter = QPointF(row->customX, row->customY);
+    } else {
+      style.position = static_cast<OverlayPosition>(m_lastPreset);
+    }
+  } else {
+    style.position =
+        static_cast<OverlayPosition>(m_positionCombo->currentData().toInt());
+  }
+  return style;
+}
+
+QSizeF SelectionFxPage::imageSizeFor(const MediaRow *row) const {
+  if (row) {
+    const QString file = row->imageCombo->currentData().toString();
+    if (!file.isEmpty()) {
+      const QString path = SelectionFx::resolveMediaPath(mediaFolder(), file);
+      if (QFileInfo::exists(path)) {
+        QImageReader reader(path);
+        const QSize size = reader.size();
+        if (size.isValid()) {
+          return QSizeF(size);
+        }
+      }
+    }
+  }
+  return QSizeF(1.0, 1.0);
+}
+
+// Stores where the row's image currently sits (for preset `from`) as a custom
+// position, so switching to Custom doesn't make anything jump.
+void SelectionFxPage::seedCustom(MediaRow *row, OverlayPosition from) {
+  SelectionFx::MediaStyle style = styleForRow(row);
+  style.custom = false;
+  style.position = from;
+
+  const QSizeF container(m_preview->size());
+  const QRectF box = SelectionFx::mediaRect(container, imageSizeFor(row), style);
+  if (box.isEmpty() || container.isEmpty()) {
+    return;
+  }
+  row->customX = qBound(0.0, box.center().x() / container.width(), 1.0);
+  row->customY = qBound(0.0, box.center().y() / container.height(), 1.0);
+  row->hasCustom = true;
+}
+
+void SelectionFxPage::seedCustomPositions() {
+  for (MediaRow *row : std::as_const(m_rows)) {
+    if (!row->hasCustom) {
+      seedCustom(row, static_cast<OverlayPosition>(m_lastPreset));
+    }
+  }
+}
+
+void SelectionFxPage::populateCombo(QComboBox *combo, const QStringList &filters,
+                                    const QString &current) {
+  const QSignalBlocker blocker(combo);
+  combo->clear();
+  combo->addItem(QStringLiteral("(none)"), QString());
+
+  const QStringList files = SelectionFx::listMediaFiles(mediaFolder(), filters);
+  for (const QString &file : files) {
+    combo->addItem(file, file);
+  }
+
+  int index = current.isEmpty() ? 0 : combo->findData(current);
+  if (index < 0) {
+    // The stored file isn't in the folder (moved or deleted): keep showing it
+    // so the setting isn't silently lost.
+    combo->addItem(
+        QStringLiteral("%1 (missing)").arg(QFileInfo(current).fileName()),
+        current);
+    index = combo->count() - 1;
+  }
+  combo->setCurrentIndex(index);
+}
