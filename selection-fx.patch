+    b->setAutoDefault(false);
+    b->setCursor(Qt::PointingHandCursor);
+  }
+  buttonRow->addWidget(addButton);
+  buttonRow->addWidget(populateButton);
+  buttonRow->addStretch();
+  characterSection->addLayout(buttonRow);
+
+  m_rowsContainer = new QWidget();
+  m_rowsLayout = new QVBoxLayout(m_rowsContainer);
+  m_rowsLayout->setContentsMargins(0, 0, 0, 0);
+  m_rowsLayout->setSpacing(6);
+  characterSection->addWidget(m_rowsContainer);
+
+  connect(addButton, &QPushButton::clicked, this, [this]() {
+    MediaRow *row = addRow(QString(), SelectionFx::CharacterMedia());
+    selectRow(row);
+    row->nameEdit->setFocus();
+  });
+  connect(populateButton, &QPushButton::clicked, this,
+          [this]() { addFromOpenWindows(); });
+
+  layout->addStretch();
+  updateAspect();
+}
+
+QString SelectionFxPage::mediaFolder() const {
+  const QString text = m_folderEdit ? m_folderEdit->text().trimmed() : QString();
+  return text.isEmpty() ? SelectionFx::defaultMediaFolder() : text;
+}
+
+void SelectionFxPage::populateCombo(QComboBox *combo, const QStringList &filters,
+                                    const QString &current) {
+  const QSignalBlocker blocker(combo);
+  combo->clear();
+  combo->addItem(QStringLiteral("(none)"), QString());
+
+  const QStringList files = SelectionFx::listMediaFiles(mediaFolder(), filters);
+  for (const QString &file : files) {
+    combo->addItem(file, file);
+  }
+
+  int index = current.isEmpty() ? 0 : combo->findData(current);
+  if (index < 0) {
+    // The stored file isn't in the folder (moved or deleted): keep showing it
+    // so the setting isn't silently lost.
+    combo->addItem(
+        QStringLiteral("%1 (missing)").arg(QFileInfo(current).fileName()),
+        current);
+    index = combo->count() - 1;
+  }
+  combo->setCurrentIndex(index);
+}
+
+MediaRow *SelectionFxPage::addRow(const QString &name,
+                                  const SelectionFx::CharacterMedia &media) {
+  auto *row = new MediaRow();
+
+  auto *outer = new QHBoxLayout(row);
+  outer->setContentsMargins(8, 6, 8, 6);
+  outer->setSpacing(8);
+
+  row->thumb = new QLabel();
+  row->thumb->setFixedSize(48, 48);
+  row->thumb->setAlignment(Qt::AlignCenter);
+  row->thumb->setStyleSheet(
+      QStringLiteral("QLabel { background-color: #1e1e1e; border: 1px solid "
+                     "#3a3a3a; border-radius: 3px; color: #777777; }"));
+  outer->addWidget(row->thumb);
+
+  auto *column = new QVBoxLayout();
+  column->setSpacing(6);
+
+  // Line 1: name, size override, delete
+  auto *top = new QHBoxLayout();
+  top->setSpacing(6);
+  row->nameEdit = new QLineEdit(name);
+  row->nameEdit->setPlaceholderText(QStringLiteral("Character name"));
+  row->nameEdit->setStyleSheet(StyleSheet::getTableCellEditorStyleSheet());
+  row->nameEdit->setAcceptDrops(false); // let file drops reach the row
+
+  row->sizeSpin = new QSpinBox();
+  row->sizeSpin->setRange(0, 100);
+  row->sizeSpin->setSuffix(QStringLiteral("%"));
+  row->sizeSpin->setSpecialValueText(QStringLiteral("Default"));
+  row->sizeSpin->setValue(media.sizePercent);
+  row->sizeSpin->setFixedWidth(90);
+  row->sizeSpin->setStyleSheet(StyleSheet::getSpinBoxStyleSheet());
+  row->sizeSpin->setToolTip(
+      QStringLiteral("Size for this character (% of the preview window). "
+                     "\"Default\" uses the default size above."));
+
+  row->deleteButton = new QPushButton(QStringLiteral("\u00D7"));
+  row->deleteButton->setFixedSize(30, 30);
+  row->deleteButton->setCursor(Qt::PointingHandCursor);
+  row->deleteButton->setToolTip(QStringLiteral("Remove this character"));
+  row->deleteButton->setAutoDefault(false);
+  row->deleteButton->setStyleSheet(QString::fromLatin1(kDeleteButtonStyle));
+
+  top->addWidget(row->nameEdit, 1);
+  top->addWidget(makeRowLabel(QStringLiteral("Size:")));
+  top->addWidget(row->sizeSpin);
+  top->addWidget(row->deleteButton);
+
+  // Line 2: image + audio pickers
+  auto *bottom = new QHBoxLayout();
+  bottom->setSpacing(6);
+
+  row->imageCombo = new QComboBox();
+  row->imageCombo->setStyleSheet(StyleSheet::getComboBoxStyleSheet());
+  row->imageCombo->setMinimumWidth(120);
+  row->imageBrowse = makeSmallButton(
+      QStringLiteral("..."),
+      QStringLiteral("Choose an image or GIF from anywhere (copied into the "
+                     "media folder)"));
+
+  row->audioCombo = new QComboBox();
+  row->audioCombo->setStyleSheet(StyleSheet::getComboBoxStyleSheet());
+  row->audioCombo->setMinimumWidth(120);
+  row->audioBrowse = makeSmallButton(
+      QStringLiteral("..."),
+      QStringLiteral("Choose an audio file from anywhere (copied into the "
+                     "media folder)"));
+  row->audioPlay = makeSmallButton(QStringLiteral("\u25B6"),
+                                   QStringLiteral("Play this audio clip"));
+
+  bottom->addWidget(makeRowLabel(QStringLiteral("Image:")));
+  bottom->addWidget(row->imageCombo, 1);
+  bottom->addWidget(row->imageBrowse);
+  bottom->addSpacing(8);
+  bottom->addWidget(makeRowLabel(QStringLiteral("Audio:")));
+  bottom->addWidget(row->audioCombo, 1);
+  bottom->addWidget(row->audioBrowse);
+  bottom->addWidget(row->audioPlay);
+
+  column->addLayout(top);
+  column->addLayout(bottom);
+  outer->addLayout(column, 1);
+
+  populateCombo(row->imageCombo, SelectionFx::imageNameFilters(), media.image);
+  populateCombo(row->audioCombo, SelectionFx::audioNameFilters(), media.audio);
+  updateRowThumb(row);
+
+  // Interacting with any part of a row makes it the previewed one.
+  connect(row->nameEdit, &QLineEdit::textEdited, this,
+          [this, row]() { selectRow(row); });
+  connect(row->imageCombo, QOverload<int>::of(&QComboBox::activated), this,
+          [this, row](int) {
+            updateRowThumb(row);
+            selectRow(row);
+          });
+  connect(row->audioCombo, QOverload<int>::of(&QComboBox::activated), this,
+          [this, row](int) { selectRow(row); });
+  connect(row->sizeSpin, QOverload<int>::of(&QSpinBox::valueChanged), this,
+          [this, row](int) { selectRow(row); });
+  connect(row->imageBrowse, &QPushButton::clicked, this,
+          [this, row]() { browseForFile(row, true); });
+  connect(row->audioBrowse, &QPushButton::clicked, this,
+          [this, row]() { browseForFile(row, false); });
+  connect(row->audioPlay, &QPushButton::clicked, this,
+          [this, row]() { playTest(row); });
+  connect(row->deleteButton, &QPushButton::clicked, this,
+          [this, row]() { removeRow(row); });
+
+  row->onFilesDropped = [this, row](const QStringList &files) {
+    handleDrop(row, files);
+  };
+  row->onClicked = [this, row]() { selectRow(row); };
+
+  m_rowsLayout->addWidget(row);
+  m_rows.append(row);
+  return row;
+}
+
+void SelectionFxPage::removeRow(MediaRow *row) {
+  const bool wasSelected = (row == m_selectedRow);
+  m_rows.removeOne(row);
+  m_rowsLayout->removeWidget(row);
+  row->hide();
+  row->deleteLater();
+
+  if (wasSelected) {
+    m_selectedRow = nullptr;
+    selectRow(m_rows.isEmpty() ? nullptr : m_rows.first());
+  }
+}
+
+void SelectionFxPage::clearRows() {
+  for (MediaRow *row : std::as_const(m_rows)) {
+    m_rowsLayout->removeWidget(row);
+    row->hide();
+    row->deleteLater();
+  }
+  m_rows.clear();
+  m_selectedRow = nullptr;
+}
+
+void SelectionFxPage::selectRow(MediaRow *row) {
+  if (m_selectedRow && m_selectedRow != row && m_rows.contains(m_selectedRow)) {
+    m_selectedRow->setSelectedLook(false);
+  }
+  m_selectedRow = row;
+  if (row) {
+    row->setSelectedLook(true);
+  }
+  updatePreview();
+}
+
+void SelectionFxPage::refreshFileLists() {
+  for (MediaRow *row : std::as_const(m_rows)) {
+    populateCombo(row->imageCombo, SelectionFx::imageNameFilters(),
+                  row->imageCombo->currentData().toString());
+    populateCombo(row->audioCombo, SelectionFx::audioNameFilters(),
+                  row->audioCombo->currentData().toString());
+    updateRowThumb(row);
+  }
+}
+
+void SelectionFxPage::updateRowThumb(MediaRow *row) {
+  const QString file = row->imageCombo->currentData().toString();
+  const QString path = SelectionFx::resolveMediaPath(mediaFolder(), file);
+
+  QPixmap pixmap;
+  if (!file.isEmpty() && QFileInfo::exists(path)) {
+    QImageReader reader(path);
+    reader.setAutoTransform(true);
+    const QSize original = reader.size();
+    if (original.isValid()) {
+      reader.setScaledSize(original.scaled(88, 88, Qt::KeepAspectRatio));
+    }
+    const QImage image = reader.read();
+    if (!image.isNull()) {
+      pixmap = QPixmap::fromImage(
+          image.scaled(44, 44, Qt::KeepAspectRatio, Qt::SmoothTransformation));
+    }
+  }
+
+  if (pixmap.isNull()) {
+    row->thumb->setPixmap(QPixmap());
+    row->thumb->setText(QStringLiteral("-"));
+  } else {
+    row->thumb->setText(QString());
+    row->thumb->setPixmap(pixmap);
+  }
+}
+
+void SelectionFxPage::updateAspect() {
+  // Make the mock window the same shape as the real thumbnails.
+  const Config &cfg = Config::instance();
+  const int width = qMax(1, cfg.thumbnailWidth());
+  const int height = qMax(1, cfg.thumbnailHeight());
+  const int boxWidth = 320;
+  const int boxHeight = qBound(100, boxWidth * height / width, 240);
+  m_preview->setFixedSize(boxWidth, boxHeight);
+}
+
+void SelectionFxPage::updatePreview() {
+  updateAspect();
+
+  int percent = m_sizeSlider->value();
+  QString path;
+  QString caption =
+      QStringLiteral("Select a character below to preview its image.");
+
+  if (m_selectedRow) {
+    const QString file = m_selectedRow->imageCombo->currentData().toString();
+    path = SelectionFx::resolveMediaPath(mediaFolder(), file);
+    if (m_selectedRow->sizeSpin->value() > 0) {
+      percent = m_selectedRow->sizeSpin->value();
+    }
+    const QString name = m_selectedRow->nameEdit->text().trimmed();
+    caption = QStringLiteral("Previewing %1 on a %2 x %3 px window at %4%.")
+                  .arg(name.isEmpty() ? QStringLiteral("(unnamed)") : name)
+                  .arg(Config::instance().thumbnailWidth())
+                  .arg(Config::instance().thumbnailHeight())
+                  .arg(percent);
+  }
+
+  m_preview->setLayoutOptions(
+      percent,
+      static_cast<OverlayPosition>(m_positionCombo->currentData().toInt()));
+  m_preview->setMedia(path);
+  m_previewCaption->setText(caption);
+}
+
+void SelectionFxPage::browseForFolder() {
+  const QString current = mediaFolder();
+  const QString start =
+      QDir(current).exists() ? current : QCoreApplication::applicationDirPath();
+  const QString dir = QFileDialog::getExistingDirectory(
+      this, QStringLiteral("Select Media Folder"), start,
+      QFileDialog::ShowDirsOnly | QFileDialog::DontResolveSymlinks);
+  if (dir.isEmpty()) {
+    return;
+  }
+  m_folderEdit->setText(dir);
+  refreshFileLists();
+  updatePreview();
+}
+
+void SelectionFxPage::browseForFile(MediaRow *row, bool image) {
+  const QString folder = mediaFolder();
+  QDir().mkpath(folder); // so the dialog opens in the media folder
+
+  const QStringList filters =
+      image ? SelectionFx::imageNameFilters() : SelectionFx::audioNameFilters();
+  const QString kind =
+      image ? QStringLiteral("Images and GIFs") : QStringLiteral("Audio");
+  const QString filter = QStringLiteral("%1 (%2);;All files (*)")
+                             .arg(kind)
+                             .arg(filters.join(QLatin1Char(' ')));
+
+  const QString path = QFileDialog::getOpenFileName(
+      this,
+      image ? QStringLiteral("Choose Image or GIF")
+            : QStringLiteral("Choose Audio File"),
+      folder, filter);
+  if (path.isEmpty()) {
+    return;
+  }
+  importAndSelect(row, image, path);
+}
+
+void SelectionFxPage::importAndSelect(MediaRow *row, bool image,
+                                      const QString &sourcePath) {
+  const QString name = SelectionFx::importIntoFolder(mediaFolder(), sourcePath);
+  if (name.isEmpty()) {
+    QMessageBox::warning(this, QStringLiteral("Could not add file"),
+                         QStringLiteral("The file could not be copied into the "
+                                        "media folder:\n%1")
+                             .arg(mediaFolder()));
+    return;
+  }
+
+  refreshFileLists(); // the new file now shows up in every dropdown
+
+  QComboBox *combo = image ? row->imageCombo : row->audioCombo;
+  const int index = combo->findData(name);
+  if (index >= 0) {
+    combo->setCurrentIndex(index);
+  }
+  if (image) {
+    updateRowThumb(row);
+  }
+  selectRow(row);
+}
+
+void SelectionFxPage::handleDrop(MediaRow *row, const QStringList &files) {
+  for (const QString &file : files) {
+    if (SelectionFx::isImageFile(file)) {
+      importAndSelect(row, true, file);
+    } else if (SelectionFx::isAudioFile(file)) {
+      importAndSelect(row, false, file);
+    }
+  }
+}
+
+void SelectionFxPage::addFromOpenWindows() {
+  QSet<QString> existing;
+  for (const MediaRow *row : std::as_const(m_rows)) {
+    existing.insert(row->nameEdit->text().trimmed());
+  }
+
+  WindowCapture capture;
+  const QVector<WindowInfo> windows = capture.getEVEWindows();
+
+  int added = 0;
+  MediaRow *firstAdded = nullptr;
+  for (const WindowInfo &window : windows) {
+    const QString name = OverlayInfo::extractCharacterName(window.title);
+    if (name.isEmpty() || existing.contains(name)) {
+      continue;
+    }
+    existing.insert(name);
+    MediaRow *row = addRow(name, SelectionFx::CharacterMedia());
+    if (!firstAdded) {
+      firstAdded = row;
+    }
+    ++added;
+  }
+
+  if (added == 0) {
+    QMessageBox::information(
+        this, QStringLiteral("No New Characters"),
+        QStringLiteral("No logged-in EVE clients were found that aren't "
+                       "already in the list."));
+  } else {
+    selectRow(firstAdded);
+  }
+}
+
+void SelectionFxPage::playTest(MediaRow *row) {
+  const QString file = row->audioCombo->currentData().toString();
+  const QString path = SelectionFx::resolveMediaPath(mediaFolder(), file);
+  if (file.isEmpty() || !QFileInfo::exists(path)) {
+    QMessageBox::information(
+        this, QStringLiteral("No Audio"),
+        QStringLiteral("Choose an audio file for this character first."));
+    return;
+  }
+
+  m_testPlayer->stop();
+  m_testOutput->setVolume(m_volumeSlider->value() / 100.0f);
+  m_testPlayer->setSource(QUrl::fromLocalFile(path));
+  m_testPlayer->play();
+  selectRow(row);
+}
+
+void SelectionFxPage::loadFromConfig() {
+  const SelectionFx::Settings fx = SelectionFx::Settings::load();
+
+  clearRows();
+
+  m_folderEdit->setText(fx.mediaFolder);
+  m_onlyOnChangeCheck->setChecked(fx.onlyOnChange);
+  m_imageCheck->setChecked(fx.imageEnabled);
+  m_sizeSlider->setValue(fx.sizePercent);
+  m_sizeValue->setText(QStringLiteral("%1%").arg(fx.sizePercent));
+  m_positionCombo->setCurrentIndex(qBound(0, fx.position, 8));
+  m_animateCheck->setChecked(fx.animationEnabled);
+  m_audioCheck->setChecked(fx.audioEnabled);
+  m_volumeSlider->setValue(fx.volume);
+  m_volumeValue->setText(QStringLiteral("%1%").arg(fx.volume));
+
+  QStringList names = SelectionFx::configuredCharacters();
+  names.sort(Qt::CaseInsensitive);
+  for (const QString &name : names) {
+    addRow(name, SelectionFx::characterMedia(name));
+  }
+  selectRow(m_rows.isEmpty() ? nullptr : m_rows.first());
+}
+
+void SelectionFxPage::saveToConfig() {
+  SelectionFx::Settings fx;
+  fx.mediaFolder = mediaFolder();
+  fx.onlyOnChange = m_onlyOnChangeCheck->isChecked();
+  fx.imageEnabled = m_imageCheck->isChecked();
+  fx.sizePercent = m_sizeSlider->value();
+  fx.position = m_positionCombo->currentData().toInt();
+  fx.animationEnabled = m_animateCheck->isChecked();
+  fx.audioEnabled = m_audioCheck->isChecked();
+  fx.volume = m_volumeSlider->value();
+  fx.save();
+
+  // Rewrite the per-character entries from the rows.
+  const QStringList existing = SelectionFx::configuredCharacters();
+  for (const QString &name : existing) {
+    SelectionFx::removeCharacterMedia(name);
+  }
+
+  for (const MediaRow *row : std::as_const(m_rows)) {
+    const QString name = row->nameEdit->text().trimmed();
+    if (name.isEmpty()) {
+      continue;
+    }
+    SelectionFx::CharacterMedia media;
+    media.image = row->imageCombo->currentData().toString();
+    media.audio = row->audioCombo->currentData().toString();
+    media.sizePercent = row->sizeSpin->value();
+    if (!media.isEmpty()) {
+      SelectionFx::setCharacterMedia(name, media);
+    }
+  }
+}
